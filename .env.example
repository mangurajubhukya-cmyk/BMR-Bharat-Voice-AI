# Public OAuth values injected by the managed Manus runtime
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Required production authentication/database values
JWT_SECRET=
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Manus Forge server credentials
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional Gnani voice integration; never prefix the API key with VITE_
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_ENABLE_STT=true
GNANI_ENABLE_TTS=true

# Optional payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
